#
# Template for a grout RFC 2544 TRex stateless traffic profile.
#
# This is a Python TRex profile. TRex loads this file and calls register() to
# get a Profile object, then calls get_streams(direction=0) and
# get_streams(direction=1) to build the streams for each direction:
#
#   direction 0: TRex port 0 -> grout p0
#   direction 1: TRex port 1 -> grout p1
#
# Every frame carries explicit source and destination MAC addresses so the test
# does not depend on ARP/NDP nor on the physical NIC MAC addresses. See
# README.md for the shared address plan. Keep this file self-contained: no
# imports beyond the TRex API.
#
# An STLVM sweeps the source UDP port of each stream so the traffic spreads
# over several flows (and thus over the receive queues) instead of hammering
# a single one. The source UDP port is used rather than the source IP address
# on purpose: changing the IP would force an L3/L4 checksum recomputation,
# while the UDP port can be rewritten freely (the checksum is left at 0).

from trex_stl_lib.api import *

# MAC addresses (see README.md).
GROUT_P0_MAC = "02:00:00:00:00:00"
GROUT_P1_MAC = "02:00:00:00:00:01"
TREX_P0_MAC = "02:00:00:00:01:00"
TREX_P1_MAC = "02:00:00:00:01:01"

# Hosts behind each grout port.
HOST_P0 = "16.0.0.1"
HOST_P1 = "48.0.0.1"

# On-wire frame size for the plain minimum-size case (60 bytes here + 4 bytes of
# FCS added by the NIC = 64 bytes on the wire).
FRAME_SIZE = 60


def sport_vm():
    # Sweep the (first) UDP source port to spread the load over many flows.
    vm = STLVM()
    vm.var(name="sport", min_value=1024, max_value=65535, size=2, op="inc")
    vm.write(fv_name="sport", pkt_offset="UDP:0.sport")
    return vm


class Profile:
    def get_streams(self, direction=0, tunables=(), **kwargs):
        if direction == 0:
            eth = Ether(src=TREX_P0_MAC, dst=GROUT_P0_MAC)
            ip = IP(src=HOST_P0, dst=HOST_P1)
        else:
            eth = Ether(src=TREX_P1_MAC, dst=GROUT_P1_MAC)
            ip = IP(src=HOST_P1, dst=HOST_P0)

        pkt = eth / ip / UDP(sport=1024, dport=1024, chksum=0)
        pkt /= max(0, FRAME_SIZE - len(pkt)) * b"x"

        return [
            STLStream(packet=STLPktBuilder(pkt=pkt, vm=sport_vm()), mode=STLTXCont())
        ]


def register():
    return Profile()
