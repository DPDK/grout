# Apply DHCPv4 leases obtained by dhcpcd to a grout interface.
#
# dhcpcd normally configures the kernel interface itself. grout interfaces are
# configured through grcli instead. Run dhcpcd in --noconfigure mode with this
# script as its event hook:
#
#   dhcpcd -4 --noconfigure -J \
#       -o classless_static_routes -o domain_name_servers \
#       -o domain_search -o domain_name \
#       -c /usr/libexec/grout/dhcpcd-hook p0
#
# IMPORTANT: dhcpcd must run in the same network namespace as grout, otherwise
# it cannot open the control plane TAP. If grout runs in a dedicated netns:
#
#   ip netns exec grout dhcpcd -4 --noconfigure -J \
#       -o classless_static_routes -o domain_name_servers \
#       -o domain_search -o domain_name \
#       -c /usr/libexec/grout/dhcpcd-hook p0
#
# -J asks the server to broadcast its replies. Until the leased address is
# configured in grout, a unicast reply cannot be routed to the control plane
# TAP.
#
# dhcpcd only exports the DHCP options that are requested. The -o options above
# are required to get the routes and DNS configuration from the lease.
#
# The interface name is the grout control plane TAP, which has the same name as
# the grout interface.
#
# The address and routes are applied with grcli. The default route and any
# extra static routes come from option 121 (classless static routes) when it is
# present, otherwise the default route comes from option 3 (routers). Routes
# are installed with the dhcp origin so that a DHCP client can only remove the
# routes it owns.
#
# DNS servers and the search domain are written to
# ${RESOLV_CONF:-/etc/resolv.conf}. grout runs in a private network namespace,
# where resolvconf and resolvectl cannot reach the control plane TAP, so the
# resolver configuration is written directly. Override RESOLV_CONF to target
# another file. dhcpcd does not pass the caller's environment to its hook,
# use -e/--env to pass RESOLV_CONF.

PATH=/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}
export PATH

iface=${interface:?missing interface}
state_file=/run/grout-dhcp.$iface
resolv_conf=${RESOLV_CONF:-/etc/resolv.conf}

# grout interfaces are backed by a kernel TAP with the same name. It only
# exists in the network namespace where grout runs.
grout_tap()
{
	local link

	link=$(ip link show dev "$iface" 2>/dev/null) || return 1
	# iproute2 prints the interface alias, busybox ip does not. When it is
	# available, make sure this is grout's control plane TAP and not an
	# unrelated interface with the same name.
	case "$link" in
	*"alias Grout control plane interface") return 0 ;;
	*"alias "*) return 1 ;;
	esac
	return 0
}

if ! grout_tap; then
	echo "grout-dhcp: $iface is not a grout control plane interface in this network namespace" >&2
	echo "grout-dhcp: dhcpcd must run in the same network namespace as grout" >&2
	exit 1
fi

grout_vrf()
{
	local vrf
	vrf=$(grcli -j interface show name "$iface" |
		sed -n 's/.*"vrf"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
	[ "$vrf" = main ] && vrf=
	printf '%s' "$vrf"
}

add_route()
{
	local dest=$1 gw=$2 vrf=$3
	set -- route add "$dest" via "$gw"
	[ -n "$vrf" ] && set -- "$@" vrf "$vrf"
	grcli "$@" origin dhcp
}

del_route()
{
	local dest=$1 vrf=$2
	set -- route del "$dest"
	[ -n "$vrf" ] && set -- "$@" vrf "$vrf"
	grcli "$@" origin dhcp
}

write_resolv()
{
	local ns domain

	if [ -z "${new_domain_name_servers:-}${new_domain_search:-}" ] &&
		[ -z "${new_domain_name:-}" ]; then
		remove_resolv
		return 0
	fi

	{
		printf '# Generated by grout-dhcp from %s\n' "$iface"
		for ns in ${new_domain_name_servers:-}; do
			printf 'nameserver %s\n' "$ns"
		done
		for domain in ${new_domain_search:-${new_domain_name:-}}; do
			printf 'search %s\n' "$domain"
		done
	} > "$resolv_conf"
}

remove_resolv()
{
	local first

	[ -f "$resolv_conf" ] || return 0
	read -r first < "$resolv_conf" || return 0
	[ "$first" = "# Generated by grout-dhcp from $iface" ] || return 0
	printf '# Generated by grout-dhcp\n' > "$resolv_conf"
}

configure()
{
	local addr dest gw prev prev_addr vrf

	[ -n "${new_ip_address:-}" ] || return 0
	[ -n "${new_subnet_cidr:-}" ] || return 0

	addr="$new_ip_address/$new_subnet_cidr"
	vrf=$(grout_vrf)

	# Remove the routes from the previous lease before replacing them.
	prev=
	prev_addr=
	[ -f "$state_file" ] && while read -r type dest gw; do
		case "$type" in
		route) prev="$prev $dest" ;;
		addr) prev_addr=$dest ;;
		esac
	done < "$state_file"
	for dest in $prev; do
		del_route "$dest" "$vrf" || :
	done

	ip link set dev "$iface" up || return 1
	if [ -n "$prev_addr" ] && [ "$prev_addr" != "$addr" ]; then
		grcli address del "$prev_addr" iface "$iface" || :
	fi
	# Re-adding an address that is already configured is a no-op.
	grcli address add "$addr" iface "$iface" || return 1

	: > "$state_file"
	printf 'addr %s\n' "$addr" >> "$state_file"
	if [ -n "${new_classless_static_routes:-}" ]; then
		# RFC 3442: when option 121 is present, option 3 must be
		# ignored, including for the default route.
		set -- $new_classless_static_routes
		while [ $# -ge 2 ]; do
			dest=$1
			gw=$2
			shift 2
			if ! add_route "$dest" "$gw" "$vrf"; then
				echo "grout-dhcp: cannot add route $dest via $gw" >&2
				continue
			fi
			printf 'route %s %s\n' "$dest" "$gw" >> "$state_file"
		done
	else
		gw=${new_routers:-}
		gw=${gw%% *}
		case "$gw" in
		"" | 0.0.0.0) gw= ;;
		esac
		if [ -n "$gw" ]; then
			if add_route 0.0.0.0/0 "$gw" "$vrf"; then
				printf 'route 0.0.0.0/0 %s\n' "$gw" >> "$state_file"
			else
				echo "grout-dhcp: cannot add default route via $gw" >&2
			fi
		fi
	fi

	write_resolv
}

deconfigure()
{
	local type dest gw vrf

	vrf=$(grout_vrf)

	if [ -f "$state_file" ]; then
		# Remove routes before the address: the explicit routes may
		# depend on the address to resolve their gateway.
		while read -r type dest gw; do
			[ "$type" = route ] || continue
			# The route may have been taken over by another
			# origin, ignore failures.
			del_route "$dest" "$vrf" || :
		done < "$state_file"
		while read -r type dest gw; do
			[ "$type" = addr ] || continue
			grcli address del "$dest" iface "$iface" || :
		done < "$state_file"
		rm -f "$state_file"
	fi

	remove_resolv
}

case "${reason:-}" in
BOUND|RENEW|REBIND|REBOOT)
	configure
	;;
RELEASE|EXPIRE|NAK|NOCARRIER|STOP|STOPPED)
	deconfigure
	;;
PREINIT|CARRIER)
	ip link set dev "$iface" up
	;;
esac
