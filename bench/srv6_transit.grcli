#
# name: SRv6 transit (End)
#
# grout is an SRv6 transit (P) node running the plain End behavior (RFC 8986
# 4.1): it neither encapsulates nor decapsulates, it just rewrites the outer IPv6
# destination to the next segment and forwards the packet out the other port.
# The two directions are asymmetric, each with its own local SID whose next
# segment lives behind the opposite port:
#   - fd00:e0::1 (ingress p0) -> next segment fd00:200::1, out p1;
#   - fd00:e1::1 (ingress p1) -> next segment fd00:100::1, out p0.

interface set port p0 mac 02:00:00:00:00:00
interface set port p1 mac 02:00:00:00:00:01

address add fd00:0::1/64 iface p0
address add fd00:1::1/64 iface p1

nexthop add l3 iface p0 id 1 address fd00:0::2 mac 02:00:00:00:01:00
nexthop add l3 iface p1 id 2 address fd00:1::2 mac 02:00:00:00:01:01

# Next segments, reachable behind the opposite port.
route add fd00:100::/64 via id 1
route add fd00:200::/64 via id 2

# Local End SIDs: rewrite the destination to the next segment and forward.
nexthop add srv6-local behavior end id 100
route add fd00:e0::1/128 via id 100
route add fd00:e1::1/128 via id 100
