# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 Robin Jarry
#
# Local SELinux policy module required to run ping(8) via 'ip vrf exec' on
# hosts with an enforcing targeted policy (e.g. evpn_l3vpn_frr_test.sh and
# evpn_l3vpn_vxlan6_frr_test.sh).
#
# 'ip vrf exec' always forces the command it runs into the ifconfig_t domain,
# regardless of what that command actually is (see ip/ipvrf.c:ipvrf_exec() in
# iproute2). ifconfig_t is meant for networking config tools labeled
# ifconfig_exec_t (ip, ifconfig, ...) and is not allowed to execute
# /usr/bin/ping (labeled ping_exec_t) nor to create the sockets it needs.
# Without this module, 'ip vrf exec <vrf> ping ...' fails with AVC denials
# (entrypoint/map/execute on ping_exec_t, create on icmp_socket/rawip_socket,
# setuid capability), ranging from a clean "Permission denied" to ping(8)
# segfaulting outright depending on which permission is missing.
#
# This grants ifconfig_t the same permissions ping_t already has over
# ping_exec_t and its own sockets, so ping keeps running confined, just under
# the domain 'ip vrf exec' happens to pick.
#
# Build and install:
#   checkmodule -M -m -o ping_vrf.mod ping_vrf.te
#   semodule_package -o ping_vrf.pp -m ping_vrf.mod
#   sudo semodule -i ping_vrf.pp
#
# Remove:
#   sudo semodule -r ping_vrf
#
# No-op on hosts without SELinux or in permissive mode.

module ping_vrf 1.0;

require {
	type ifconfig_t;
	type ping_exec_t;
	class file { entrypoint execute getattr ioctl lock map open read };
	class icmp_socket { append bind connect create getattr getopt ioctl lock read setattr setopt shutdown write };
	class rawip_socket { append bind connect create getattr getopt ioctl lock read setattr setopt shutdown write };
	class capability setuid;
}

#============= ifconfig_t ==============
allow ifconfig_t ping_exec_t:file { entrypoint execute getattr ioctl lock map open read };
allow ifconfig_t ifconfig_t:icmp_socket { append bind connect create getattr getopt ioctl lock read setattr setopt shutdown write };
allow ifconfig_t ifconfig_t:rawip_socket { append bind connect create getattr getopt ioctl lock read setattr setopt shutdown write };
allow ifconfig_t ifconfig_t:capability setuid;
